@page "/login"
@layout TimeTrackingApp.Layout.MainLayout
@inject AuthService Auth
@inject NavigationManager Nav

<div class="login-container">
    <div class="login-card">
        <h2>TimeTracking MM</h2>
        <p class="login-subtitle">Connectez-vous pour continuer</p>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert-error">@errorMessage</div>
        }

        <EditForm Model="loginModel" OnValidSubmit="HandleLogin">
            <div class="form-group">
                <label for="username">Nom d'utilisateur</label>
                <InputText id="username" @bind-Value="loginModel.Username" class="form-input"
                           placeholder="Entrez votre identifiant" />
            </div>

            <div class="form-group">
                <label for="password">Mot de passe</label>
                <InputText id="password" @bind-Value="loginModel.Password" class="form-input"
                           type="password" placeholder="Entrez votre mot de passe" />
            </div>

            <button type="submit" class="btn-primary btn-full" disabled="@isLoading">
                @if (isLoading)
                {
                    <span>Connexion...</span>
                }
                else
                {
                    <span>Se connecter</span>
                }
            </button>
        </EditForm>
    </div>
</div>

@code {
    private LoginRequest loginModel = new();
    private string? errorMessage;
    private bool isLoading;

    protected override void OnInitialized()
    {
        if (Auth.IsAuthenticated)
        {
            Nav.NavigateTo("");
        }
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = null;

        var success = await Auth.LoginAsync(loginModel.Username, loginModel.Password);

        if (success)
        {
            Nav.NavigateTo("");
        }
        else
        {
            errorMessage = "Identifiants incorrects. Veuillez réessayer.";
        }

        isLoading = false;
    }
}
